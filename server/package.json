{
  "name": "ticketing-api",
  "version": "1.0.0",
  "description": "ticketing-service",
  "main": "index.js",
  "scripts": {
    "dev:auth": "ts-node-dev  auth/src/server.ts",
    "dev:tickets": "ts-node-dev tickets/src/server.ts",
    "dev:orders": "ts-node-dev orders/src/server.ts",
    "dev:expiration": "ts-node-dev expiration/src/server.ts",
    "dev:payments": "ts-node-dev payments/src/server.ts",
    "clean": "del ./build/*",
    "build": "npm run clean && tsc",
    "pub": "git add . && git commit -m \"Updates\" && npm version patch && npm run build && npm publish",
    "test": "jest --watchAll --no-cache --detectOpenHandles",
    "test:ci": "jest",
    "test:auth": "jest --testMatch='<rootDir>/auth/src/**/*.test.ts'"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 10000,
    "setupFilesAfterEnv": [
      "./auth/src/test/index.ts"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/common/src/$1"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@alibabatickets/common": "^1.0.10",
    "@types/bull": "^4.10.4",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "bull": "^4.16.5",
    "cookie-session": "^2.1.1",
    "dotenv": "^17.2.1",
    "express": "^4.18.1",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "mongoose": "^8.16.4",
    "mongoose-update-if-current": "^1.4.0",
    "node-nats-streaming": "^0.3.2",
    "stripe": "^18.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.0.4",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "debug": "1"
    },
    "_moduleAliases": {
      "@app/common": "./common/src/"
    }
  }
}
