{
  "name": "ticketing-api",
  "version": "1.0.0",
  "description": "ticketing-service",
  "main": "index.js",
  "scripts": {
    "run:tickets": "ts-node-dev src/server.ts",
    "dev:tickets": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest --watchAll --no-cache --detectOpenHandles",
    "test:ci": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 15000,
    "setupFilesAfterEnv": [
      "./src/test/index.ts"
    ],
    "silent": true
  },
  "dependencies": {
    "@alibabatickets/common": "^1.0.24",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0",
    "mongoose-update-if-current": "^1.4.0",
    "nats": "^2.29.3",
    "node-nats-streaming": "^0.3.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.4.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6"
  }
}
